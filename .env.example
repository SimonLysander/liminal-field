# ── Liminal Field 环境配置 ──
# 复制为 .env 后填入真实值，不要提交到 git。
#
# 归属准则见 CLAUDE.md「配置归属准则」：本文件只放「部署级 / 机密 / 基础设施」配置
# （换部署才变、应用没它起不来、运维管）。业务配置——远端同步(remoteUrl/gitToken/
# gitAuthor*/gitSyncCron)、MinerU token、AI providers、owner、agent——在 Settings UI
# 配置并存入 Mongo，**不在这里设**。

# ── MongoDB（基础设施）──
MONGO_HOST=localhost          # Docker 部署时填容器名：mongo
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=changeme
MONGO_DATABASE=liminal-field

# ── 阿里云 OSS（对象存储凭证）──
OSS_REGION=oss-cn-beijing
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=lux-stirring
OSS_INTERNAL=false            # 服务器在同区阿里云内网时设 true（走内网 endpoint 省流量）

# ── Knowledge Base 本地归档路径 ──
CONTENT_REPO_ROOT=./liminal-field-kb   # Docker 部署时填：/data/liminal-field-kb

# ── Auth（机密）──
JWT_SECRET=changeme
ADMIN_PASSWORD=changeme
COOKIE_SECURE=                # HTTPS 部署时设 true（cookie 仅经 https 传输）

# ── 站点域名（Caddy 自动 HTTPS 用）──
SITE_DOMAIN=localhost         # 有域名填域名；无域名 / 纯 HTTP 填 :80

# ── 系统内部容错定时（管理员无需调，留空用代码默认 0 3 * * *）──
# GIT_ARCHIVE_RETRY_CRON=0 3 * * *

# ── AI 运行保护边界（可选，留空使用括号内的宽松默认值）──
# 这些不是业务配额，只用于防止供应商永久挂起或工具无限循环。
# AI_REQUEST_TIMEOUT_MS=900000        # 单次 Responses 请求：15 分钟
# AI_MAX_RETRIES=4                    # 仅重试网络错误、限流和 5xx
# AI_MAX_RETRY_DELAY_MS=300000        # 接受最长 5 分钟 Retry-After
# AI_MAX_OUTPUT_TOKENS=131072         # 输出上限：128K，仍受模型上下文约束
# AGENT_MAX_TURNS=50                  # 主 Agent 单轮对话的工具循环保护上限
# SUB_AGENT_DEFAULT_STEPS=30
# SUB_AGENT_MAX_STEPS=60
# SUB_AGENT_TIMEOUT_MS=1200000        # 子 Agent 总时长：20 分钟
# INLINE_ASSIST_TIMEOUT_MS=300000      # 行内编辑：5 分钟

# ── RSSHub（RSS 聚合代理）──
# Docker Compose 内部访问，无需改动；本地开发可指向公共实例或自建实例
# RSSHUB_BASE_URL=http://rsshub:1200

# ── Web Fetch（外部页面读取，可选）──
# auto=服务器直抓 + Firecrawl keyless/API + Jina Reader fallback；direct=只直抓；firecrawl=只走 Firecrawl；jina=只走 Jina Reader
# WEB_FETCH_PROVIDER=auto
# FIRECRAWL_API_KEY=
# JINA_API_KEY=
